# For local development only. On Vercel, set these in Settings → Environment Variables.
# Leave the key empty to use offline task suggestions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Secret word for POST /api/reset?key=...
RESET_KEY=
# Optional: use a real Upstash Redis locally (Vercel adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
PORT=3000
